{
  "about": "Install steps run as Nextflow tasks by workflows/install.nf. Each step calls existing installer functions from scripts/install_utils.sh with its own private configuration, whose cache_root is the step's lineage folder. Tokens: {config} is that configuration, {script_dir} the scripts folder, {KEY} the configuration value of KEY. needs: steps whose receipts supply input keys. outputs: keys the step must set; optional_outputs may be empty. user_inputs: keys naming files you supply, kept from your configuration and counted in lineage. settings: configuration values that change results (glob patterns allowed). copies: input keys the step rewrites in place; the runner copies them into the step's own folder first. writable: the folder stays writable after the step (otherwise it is made read-only). native: the step's results are computed by priva, so the priva source identity counts in its lineage.",
  "folder_keys": [
    "cache_root",
    "vep_cache_dir",
    "vep_plugins_dir",
    "vep_plugins_cachedir",
    "gnomad_vcf_dir",
    "clinvar_vcf_dir",
    "cadd_parent_dir",
    "cadd_base_dir",
    "loftee_parent_dir",
    "hpo_raw_dir",
    "gene_mechanism_cache_dir",
    "gene_mechanism_raw_dir",
    "gofcards_workdir",
    "pext_tissue_bw_dir"
  ],
  "steps": [
