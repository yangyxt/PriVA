          "{vep_cache_dir}",
          "--VEP_PLUGINSDIR",
          "{vep_plugins_dir}",
          "--VEP_ASSEMBLY",
          "{assembly}",
          "--VEP_PLUGINSCACHEDIR",
          "{vep_plugins_cachedir}",
          "--config",
          "{config}"
        ]
      ],
      "needs": [],
      "outputs": [
        "vep_cache_dir",
        "vep_plugins_dir"
      ],
      "settings": [
        "assembly",
        "vep_installed_version"
      ],
      "release": [
