manifest {
    name = 'PriVA/nextflow-compatibility'
    description = 'Single-family PriVA orchestration with unchanged scientific implementation'
    version = '0.1.0-dev'
    nextflowVersion = '!>=25.10.4'
    mainScript = 'main.nf'
}

params {
    help = false
    input = null
    vcf_index = null
    ped = null
    family = null
    assembly = null
    legacy_config = null
    resource_manifest = null
    software_id = null
    outdir = null
    mode = 'raw'
    cadd = null
    vcf_hub_mode = 'off'
    cadd_hub_mode = 'copy'
    annotation_cpus = 4
    annotation_memory = '8 GB'
    annotation_time = '12h'
    family_cpus = 1
    family_memory = '8 GB'
    family_time = '4h'
    slurm_queue = null
    slurm_account = null
    container_image = null
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-e', '-o', 'pipefail']
    errorStrategy = 'terminate'
    maxRetries = 0
    cpus = 1
    memory = '1 GB'
    time = '30m'
    withLabel: annotation {
        cpus = { params.annotation_cpus }
        memory = { params.annotation_memory }
        time = { params.annotation_time }
    }
    withLabel: family {
        cpus = { params.family_cpus }
        memory = { params.family_memory }
        time = { params.family_time }
    }
}

profiles {
    local { process.executor = 'local' }
    slurm { includeConfig 'conf/slurm.config' }
    apptainer { includeConfig 'conf/apptainer.config' }
    test { includeConfig 'conf/test.config' }
    task_readonly { includeConfig 'conf/task_readonly.config' }
}

// The caller supplies a durable work directory via -work-dir. A new output
// directory per run avoids silently replacing an earlier acceptance result.
timeline { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/timeline-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html"; overwrite = false }
report { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/report-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html"; overwrite = false }
trace { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/trace-${new Date().format('yyyyMMdd-HHmmss-SSS')}.tsv"; overwrite = false }
dag { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/dag-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html"; overwrite = false }
