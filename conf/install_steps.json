      "id": "A1",
      "name": "REFERENCE_FASTA",
      "calls": [
        [
          "reference_genome_install",
          "{config}"
        ]
      ],
      "needs": [],
      "outputs": [
        "ref_genome"
      ],
      "settings": [
        "assembly"
      ]
    },
    {
      "id": "A2",
      "name": "VEP_CACHE",
      "calls": [
        [
          "vep_cache_api_install",
          "--VEP_VERSION",
          "{vep_installed_version}",
          "--VEP_CACHEDIR",
          "{vep_cache_dir}",
          "--VEP_PLUGINSDIR",
          "{vep_plugins_dir}",
          "--VEP_ASSEMBLY",
          "{assembly}",
          "--VEP_PLUGINSCACHEDIR",
          "{vep_plugins_cachedir}",
          "--config",
          "{config}"
        ]
      ],
      "needs": [],
      "outputs": [
        "vep_cache_dir",
        "vep_plugins_dir"
      ],
      "settings": [
        "assembly",
        "vep_installed_version"
      ],
      "release": [
        {
          "kind": "git",
          "url": "https://github.com/Ensembl/VEP_plugins.git",
          "ref": "refs/heads/release/{vep_installed_version}"
        }
      ]
    },
