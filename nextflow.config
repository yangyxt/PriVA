manifest {
    name = 'PriVA/nextflow-compatibility'
    description = 'PriVA cohort workflow: one annotation, then filtration and prioritization per PED family'
    version = '0.1.0-dev'
    nextflowVersion = '!>=25.10.4'
    mainScript = 'main.nf'
}

params {
    help = false
    input = null
    vcf_index = null
    ped = null
    family = null
    assembly = null
    legacy_config = null
    resource_manifest = null
    software_id = null
    outdir = null
    mode = 'raw'
    cadd = null
    // Removed options, kept only so that setting them gives a clear refusal.
    vcf_hub_mode = 'off'
    cadd_hub_mode = 'off'
    // Annotation hub folder (raw mode): stored step results reused across runs.
    annotation_hub = null
    // resources.lock.json from --action install: hub folders named from install lineages.
    resources_lock = null
    annotation_cpus = 4
    annotation_memory = '8 GB'
    annotation_time = '12h'
    // The light annotation steps (preprocess, gnomAD, ClinVar, control, merge).
    annotation_step_cpus = 2
    annotation_step_memory = '8 GB'
    annotation_step_time = '6h'
    family_cpus = 1
    family_memory = '8 GB'
    family_time = '4h'
    slurm_queue = null
    slurm_account = null
    slurm_cluster_options = null
    container_image = null
    container_run_options = null
    local_cpus = null
    priva_binary = null
    // Install workflow (--action install): see workflows/install.nf.
    action = 'run'
    install_config = null
    resource_root = null
    install_outdir = null
    install_registry = null
    adopt_config = null
    adopt = null
    run_steps = null
    install_cpus = 8
    install_memory = '64 GB'
    install_time = '48h'
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-e', '-o', 'pipefail']
    errorStrategy = 'terminate'
    maxRetries = 0
    cpus = 1
    memory = '1 GB'
    time = '30m'
    withLabel: annotation {
        cpus = { params.annotation_cpus }
        memory = { params.annotation_memory }
        time = { params.annotation_time }
    }
    withLabel: annotation_step {
        cpus = { params.annotation_step_cpus }
        memory = { params.annotation_step_memory }
        time = { params.annotation_step_time }
    }
    withLabel: family {
        cpus = { params.family_cpus }
        memory = { params.family_memory }
        time = { params.family_time }
    }
    withLabel: install {
        cpus = { params.install_cpus }
        memory = { params.install_memory }
        time = { params.install_time }
    }
    withLabel: install_light {
        cpus = 1
        memory = '4 GB'
        time = '2h'
    }
}

// The installed driver limits its own JVM to 2 processors, which the local
// executor would otherwise take as the machine size; --local_cpus gives the
// CPUs the local executor may hand to tasks (for example the Slurm job's).
executor {
    cpus = params.local_cpus ?: Runtime.runtime.availableProcessors()
}

profiles {
    local { process.executor = 'local' }
    slurm { includeConfig 'conf/slurm.config' }
    apptainer { includeConfig 'conf/apptainer.config' }
    test { includeConfig 'conf/test.config' }
    task_readonly { includeConfig 'conf/task_readonly.config' }
}

// The caller supplies a durable work directory via -work-dir. A new output
// directory per run avoids silently replacing an earlier acceptance result.
timeline { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/timeline-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html"; overwrite = false }
report { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/report-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html"; overwrite = false }
trace { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/trace-${new Date().format('yyyyMMdd-HHmmss-SSS')}.tsv"; overwrite = false }
dag { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/dag-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html"; overwrite = false }
