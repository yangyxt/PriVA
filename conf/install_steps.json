      "id": "A1",
      "name": "REFERENCE_FASTA",
      "calls": [
        [
          "reference_genome_install",
          "{config}"
        ]
      ],
      "needs": [],
      "outputs": [
        "ref_genome"
      ],
      "settings": [
        "assembly"
      ]
    },
    {
      "id": "A2",
      "name": "VEP_CACHE",
      "calls": [
