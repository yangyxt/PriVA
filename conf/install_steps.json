          "nm_to_enst_mapping_install",
          "{config}"
        ]
      ],
      "needs": [],
      "outputs": [
        "nm_to_enst_tsv"
      ],
      "settings": [
        "assembly",
        "vep_installed_version"
      ],
      "native": true
    },
    {
      "id": "B1",
      "name": "UTR_ANNOTATOR",
      "calls": [
