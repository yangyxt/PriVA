includeConfig '../nextflow.config'

// Supply together with the independent cadd.nf entry point. Installed paths
// live in the explicit CADD profile, not in process environment inheritance.
params {
    cadd_mode = 'full'
    cadd_profile = null
    cadd_annotation_source = 'shared-vep'
    shared_vep_bundle = null
    annotation_bundle = null
    cadd_annotation_cpus = 1
    cadd_annotation_memory = '16 GB'
    cadd_annotation_time = '24h'
    cadd_calculation_cpus = 1
    cadd_calculation_memory = '4 GB'
    cadd_calculation_time = '4h'
}
process {
    withLabel: cadd_annotation {
        cpus = { params.cadd_annotation_cpus }
        memory = { params.cadd_annotation_memory }
        time = { params.cadd_annotation_time }
    }
    withLabel: cadd_calculation {
        cpus = { params.cadd_calculation_cpus }
        memory = { params.cadd_calculation_memory }
        time = { params.cadd_calculation_time }
    }
}
