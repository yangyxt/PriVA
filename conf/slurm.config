// Submit the Nextflow driver in an approved allocation/service; the driver
// must be allowed to submit jobs. Keep work and .nextflow/cache durable.
process {
    executor = 'slurm'
    queue = params.slurm_queue
    clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : ''
}
executor { queueSize = 16; submitRateLimit = '2 sec' }
