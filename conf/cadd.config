includeConfig '../nextflow.config'

// Supply together with the independent cadd.nf entry point.
params {
    cadd_base_dir = null
    cadd_cpus = 1  // CADD.sh -c; raise it for larger inputs
    cadd_memory = '32 GB'
    cadd_time = '24h'
}
process {
    withLabel: cadd {
        cpus = { params.cadd_cpus }
        memory = { params.cadd_memory }
        time = { params.cadd_time }
    }
}
