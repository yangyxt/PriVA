manifest {
    name = 'PriVA/nextflow-compatibility'
    description = 'PriVA cohort workflow: one annotation, then filtration and prioritization per PED family'
    version = '0.1.0-dev'
    nextflowVersion = '!>=25.10.4'
    mainScript = 'main.nf'
}

params {
    help = false
    input = null
    vcf_index = null
    ped = null
    family = null
    assembly = null
    legacy_config = null
    resource_manifest = null
    software_id = null
    outdir = null
    mode = 'raw'
    cadd = null
    // Removed options, kept only so that setting them gives a clear refusal.
    vcf_hub_mode = 'off'
    cadd_hub_mode = 'off'
    // Annotation hub folder (raw mode): stored step results reused across runs.
    annotation_hub = null
    // resources.lock.json from --action install: hub folders named from install lineages.
    resources_lock = null
    annotation_cpus = 4
    annotation_memory = '8 GB'
    annotation_time = '12h'
    // The light annotation steps (preprocess, gnomAD, ClinVar, control, merge).
    annotation_step_cpus = 2
    annotation_step_memory = '8 GB'
    annotation_step_time = '6h'
    family_cpus = 1
    family_memory = '8 GB'
    family_time = '4h'
    // With --annotation_hub, VEP and CADD run on one piece per chromosome:
    // CPUs and memory of each VEP piece (VEP forks = CPUs - 2) and of each
    // CADD piece, and the time limit of every piece.
    vep_piece_cpus = 8
    vep_piece_memory = '32 GB'
    cadd_piece_cpus = 4
    cadd_piece_memory = '32 GB'
    piece_time = '3d'
    slurm_queue = null
    slurm_account = null
    slurm_cluster_options = null
    container_image = null
    container_run_options = null
    local_cpus = null
    priva_binary = null
    // The optional phenotype gene bonus (see main.nf --help).
    phenotype_hpo_terms = null
    // Removed: the ranking is built into priva and its reference is installed.
    hpo_gene_ranking_binary = null
    hpo_gene_ranking_reference = null
    // Install workflow (--action install): see workflows/install.nf.
    action = 'run'
    install_config = null
    resource_root = null
    install_outdir = null
    install_registry = null
    adopt_config = null
    adopt = null
    run_steps = null
    // Pinned install sources to check for a new release, by step id: --refresh B5,B8
    refresh = null
    install_cpus = 8
    install_memory = '64 GB'
    install_time = '48h'
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-e', '-o', 'pipefail']
    errorStrategy = 'terminate'
    maxRetries = 0
    cpus = 1
    memory = '1 GB'
    time = '30m'
    withLabel: annotation {
        cpus = { params.annotation_cpus }
        memory = { params.annotation_memory }
        time = { params.annotation_time }
    }
    withLabel: annotation_step {
        cpus = { params.annotation_step_cpus }
        memory = { params.annotation_step_memory }
        time = { params.annotation_step_time }
    }
    withLabel: family {
        cpus = { params.family_cpus }
        memory = { params.family_memory }
        time = { params.family_time }
    }
    // A step adopted from an existing installation only writes its receipt
    // (lineage "adopted-..."), so it asks for 1 CPU, 1 GB and 30 minutes,
    // also where a rule below gives the step more (job 1547520: an adopted
    // ClinVar VEP piece asked for 24 CPUs).
    withLabel: install {
        cpus = { lineage.startsWith('adopted-') ? 1 : params.install_cpus }
        memory = { lineage.startsWith('adopted-') ? '1 GB' : params.install_memory }
        time = { lineage.startsWith('adopted-') ? '30m' : params.install_time }
    }
    // One family's gene ranking: about 1 GB and well under a minute.
    withLabel: phenotype_ranking {
        cpus = 1
        memory = '4 GB'
        time = '1h'
    }
    withLabel: install_light {
        cpus = 1
        memory = '4 GB'
        time = '2h'
    }
    // An install step that only downloads and checks files (its own process,
    // modules/local/install_steps/): 1 CPU and 4 GB, with the install time
    // (the 9.6 GB conservation file took about 4 hours, job 1545925).
    withLabel: install_download {
        cpus = 1
        memory = { lineage.startsWith('adopted-') ? '1 GB' : '4 GB' }
        time = { lineage.startsWith('adopted-') ? '30m' : params.install_time }
    }
    // The 24 gnomAD chromosome downloads (install steps C1_chrN) only fetch and index.
    withName: '.*_GNOMAD_DOWNLOAD_CHR.*' {
        cpus = 1
        memory = { lineage.startsWith('adopted-') ? '1 GB' : '4 GB' }
        time = { lineage.startsWith('adopted-') ? '30m' : params.install_time }
    }
    // ClinVar VEP per chromosome (install steps D1_chrN) runs VEP with 22
    // forks, the compared route; VEP 116 needs forks + 2 CPUs. In job 1542391
    // the pieces took 13 minutes to 3 h 15 min and peaked at 35 GB (chr17;
    // every other piece below 17 GB). One retry: a piece failed once while its
    // folders were set up and passed when run again.
    withName: '.*_CLINVAR_VEP_CHR.*' {
        cpus = { lineage.startsWith('adopted-') ? 1 : 24 }
        memory = { lineage.startsWith('adopted-') ? '1 GB' : '64 GB' }
        time = { lineage.startsWith('adopted-') ? '30m' : '24h' }
        errorStrategy = 'retry'
        maxRetries = 1
    }
    withName: '.*_CLINVAR_VEP_SPLIT' {
        cpus = 1
        memory = { lineage.startsWith('adopted-') ? '1 GB' : '4 GB' }
        time = { lineage.startsWith('adopted-') ? '30m' : '2h' }
    }
}

// The installed driver limits its own JVM to 2 processors, which the local
// executor would otherwise take as the machine size; --local_cpus gives the
// CPUs the local executor may hand to tasks (for example the Slurm job's).
executor {
    cpus = params.local_cpus ?: Runtime.runtime.availableProcessors()
}

profiles {
    local { process.executor = 'local' }
    slurm { includeConfig 'conf/slurm.config' }
    apptainer { includeConfig 'conf/apptainer.config' }
    test { includeConfig 'conf/test.config' }
    task_readonly { includeConfig 'conf/task_readonly.config' }
}

// The caller supplies a durable work directory via -work-dir. A new output
// directory per run avoids silently replacing an earlier acceptance result.
timeline { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/timeline-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html"; overwrite = false }
report { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/report-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html"; overwrite = false }
trace { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/trace-${new Date().format('yyyyMMdd-HHmmss-SSS')}.tsv"; overwrite = false }
dag { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/dag-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html"; overwrite = false }
