// Supply a tested image pinned by digest/path plus --software_id. This profile
// does not build an image or claim the legacy Dockerfile is production ready.
// --cleanenv keeps the host PATH out, so tasks run the image's tools. Add the
// site's data and cache folders with --container_run_options, for example
// --container_run_options='-B /data'; Nextflow mounts only staged inputs.
apptainer {
    enabled = true
    autoMounts = true
    runOptions = "--cleanenv ${params.container_run_options ?: ''}".trim()
}
process.container = params.container_image
