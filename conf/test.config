// Wiring tests only. This is used together with -stub-run, never acceptance.
process {
    executor = 'local'
    cpus = 1
    memory = '512 MB'
    time = '5m'
    maxForks = 1
    withLabel: annotation { cpus = 1; memory = '512 MB'; time = '5m' }
    withLabel: family { cpus = 1; memory = '512 MB'; time = '5m' }
}
