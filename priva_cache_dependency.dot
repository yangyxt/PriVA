    "data:all_intolerant_domains" [shape=box, style=filled, fillcolor="#dbeafe", color="#3b82f6", label="DAS all intolerant domains"];
    "data:pm1_regions_pkl" [shape=box, style=filled, fillcolor="#dbeafe", color="#3b82f6", label="PM1 regions"];
    "data:hcseeker_spots_tsv" [shape=box, style=filled, fillcolor="#dbeafe", color="#3b82f6", label="HCSeeker hotspots"];
    "data:rmc_tsv" [shape=box, style=filled, fillcolor="#dbeafe", color="#3b82f6", label="gnomAD RMC flat TSV"];
    "func:AlphaMissense_install" [shape=ellipse, style=filled, fillcolor="#fed7aa", color="#ea580c", label="AlphaMissense_install"];
    "func:AlphaMissense_anno" [shape=ellipse, style=filled, fillcolor="#fed7aa", color="#ea580c", label="AlphaMissense_anno"];
    "func:AlphaMissense_anno_gnomAD" [shape=ellipse, style=filled, fillcolor="#fed7aa", color="#ea580c", label="AlphaMissense_anno_gnomAD"];
    "func:AlphaMissense_pick_missense_constrained_segments" [shape=ellipse, style=filled, fillcolor="#fed7aa", color="#ea580c", label="AlphaMissense_pick_missense_constrained_segments"];
