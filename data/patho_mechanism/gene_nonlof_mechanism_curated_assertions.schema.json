{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.yangyxt/gene_nonlof_mechanism_curated_assertions.schema.json",
  "title": "Canonical Non-LOF Gene Mechanism Assertions",
  "type": "object",
  "required": [
    "_meta"
  ],
  "properties": {
    "_meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "patternProperties": {
    "^HGNC:[0-9]+$": {
      "$ref": "#/$defs/gene"
    },
    "^SYMBOL:.+$": {
      "$ref": "#/$defs/gene"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "meta": {
      "type": "object",
      "required": [
        "version",
        "built_at",
        "total_genes",
        "sources"
      ],
      "properties": {
        "version": {
          "const": "2.0"
        },
        "built_at": {
          "type": "string"
        },
        "total_genes": {
          "type": "integer",
          "minimum": 0
        },
        "unmapped_symbols": {
          "$ref": "#/$defs/stringArray"
        },
        "mechanism_values": {
          "$ref": "#/$defs/stringArray"
        },
        "sources": {
          "type": "object"
        },
        "clinvar_vcv_integration": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "gene": {
      "type": "object",
      "required": [
        "symbol",
        "mechanisms"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "entrez_id": {
          "type": "string"
        },
        "ensembl_id": {
          "type": "string"
        },
        "mechanisms": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "gene_level": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/geneAssertion"
          }
        },
        "variant_level": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variantAssertion"
          }
        }
      },
      "additionalProperties": false
    },
    "geneAssertion": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "G2P_DDG2P": {
          "$ref": "#/$defs/g2pAssertion"
        },
        "PanelApp": {
          "$ref": "#/$defs/panelAppAssertion"
        },
        "ClinGen_Dosage": {
          "$ref": "#/$defs/clinGenDosageAssertion"
        }
      },
      "additionalProperties": false
    },
    "g2pAssertion": {
      "type": "object",
      "required": [
        "mechanism"
      ],
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "mechanism_raw": {
          "type": "string",
          "minLength": 1
        },
        "disease": {
          "type": "string",
          "minLength": 1
        },
        "inheritance": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "moderate",
            "limited",
            "conflicting_or_refuted"
          ]
        },
        "pmids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      },
      "additionalProperties": false
    },
    "panelAppAssertion": {
      "type": "object",
      "required": [
        "mechanism",
        "confidence"
      ],
      "properties": {
        "mechanism": {
          "const": "PANELAPP_GREEN_NON_LOF_PATHO_HISTORY"
        },
        "panel": {
          "type": "string",
          "minLength": 1
        },
        "panel_id": {
          "type": "string",
          "minLength": 1
        },
        "inheritance": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "const": "high"
        }
      },
      "additionalProperties": false
    },
    "clinGenDosageAssertion": {
      "type": "object",
      "required": [
        "mechanism",
        "score"
      ],
      "properties": {
        "mechanism": {
          "const": "TRIPLOSENSITIVITY"
        },
        "score": {
          "enum": [
            "2",
            "3"
          ]
        },
        "score_description": {
          "type": "string",
          "minLength": 1
        },
        "pmids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      },
      "additionalProperties": false
    },
    "variantAssertion": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "GoFCards": {
          "$ref": "#/$defs/gofcards"
        },
        "ClinVar_VCV": {
          "$ref": "#/$defs/clinvarVCV"
        }
      },
      "additionalProperties": false
    },
    "gofcards": {
      "type": "object",
      "required": [
        "mechanism",
        "source_record_id",
        "allele_key",
        "exact_normalization_status"
      ],
      "properties": {
        "mechanism": {
          "const": "GOF"
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "allele_key": {
          "type": "string",
          "minLength": 1
        },
        "exact_normalization_status": {
          "enum": [
            "matched_gene_concordant",
            "quarantined_upstream_gene_discordance",
            "quarantined_upstream_mechanism_review",
            "unmatched_public_source_allele"
          ]
        },
        "exact_normalized_variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gofcardsExactNormalizedVariant"
          }
        },
        "quarantined_exact_normalized_variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gofcardsExactNormalizedVariant"
          }
        },
        "disease": {
          "type": "string",
          "minLength": 1
        },
        "chr": {
          "type": "string",
          "minLength": 1
        },
        "pos": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "consequence": {
          "enum": [
            "missense_variant",
            "indel"
          ]
        },
        "pscore": {
          "type": "number"
        },
        "pmids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "pathway": {
          "type": "string",
          "minLength": 1
        },
        "animal_model": {
          "const": true
        },
        "cell_model": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exact_normalization_status": {
                "const": "matched_gene_concordant"
              }
            }
          },
          "then": {
            "required": [
              "exact_normalized_variants"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "exact_normalization_status": {
                "const": "quarantined_upstream_gene_discordance"
              }
            }
          },
          "then": {
            "required": [
              "quarantined_exact_normalized_variants"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "exact_normalization_status": {
                "const": "quarantined_upstream_mechanism_review"
              }
            }
          },
          "then": {
            "required": [
              "quarantined_exact_normalized_variants"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "gofcardsExactNormalizedVariant": {
      "description": "One GoFCards variant embedded verbatim from the normalized cache. Only its identifier and source label are stamped alongside; the gene comes from the assertion this is nested under, and the eligibility verdict from record.eligibility.status. The nested 'record' and 'assemblies' blocks are the contract the runtime hub reads.",
      "type": "object",
      "required": [
        "source",
        "mechanism",
        "variant_id",
        "record",
        "assemblies"
      ],
      "properties": {
        "source": {
          "const": "GoFCards"
        },
        "mechanism": {
          "const": "GOF"
        },
        "variant_id": {
          "description": "Stable identity: loc_<chrom>:<start>:<ref>-><alt>_grch37",
          "type": "string",
          "pattern": "^loc_[^:]+:\\d+:[^>]+->[^_]+_grch37$"
        },
        "record": {
          "type": "object",
          "required": [
            "source",
            "eligibility",
            "liftover_status",
            "annotations",
            "evidence"
          ],
          "properties": {
            "source": {
              "description": "The GoFCards workbook allele, as published.",
              "type": "object",
              "required": [
                "gofcards_allele_key",
                "assembly",
                "chrom",
                "start",
                "ref",
                "alt"
              ],
              "properties": {
                "gofcards_allele_key": {
                  "type": "string",
                  "minLength": 1
                },
                "variant_type_label": {
                  "type": "string"
                },
                "assembly": {
                  "const": "hg19"
                },
                "chrom": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "string",
                  "minLength": 1
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "eligibility": {
              "type": "object",
              "required": [
                "status",
                "gene_match_status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "eligible",
                    "quarantined_gene_discordance",
                    "quarantined_allele_gene_discordance",
                    "quarantined_missing_source_gene",
                    "quarantined_reviewed_lof",
                    "quarantined_reviewed_mixed",
                    "quarantined_reviewed_dominant_negative",
                    "quarantined_reviewed_uncertain",
                    "quarantined_reviewed_exclude",
                    "quarantined_mechanism_review_required"
                  ]
                },
                "gene_match_status": {
                  "enum": [
                    "gene_concordant",
                    "source_gene_only",
                    "gene_discordant",
                    "missing_source_gene"
                  ]
                },
                "vep_symbol": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "description": "Required whenever status is not 'eligible'.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            },
            "liftover_status": {
              "enum": [
                "mapped",
                "unmapped",
                "endpoint_recovered"
              ]
            },
            "annotations": {
              "type": "object"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        },
        "assemblies": {
          "description": "Keyed by build. A variant the liftover cannot place carries hg19 only, so at least one build is required rather than both.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "hg19",
              "hg38"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "genomic",
              "transcripts"
            ],
            "properties": {
              "genomic": {
                "type": "object",
                "required": [
                  "chrom",
                  "pos",
                  "ref",
                  "alt",
                  "status"
                ],
                "properties": {
                  "chrom": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pos": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              },
              "transcripts": {
                "description": "Keyed by versioned transcript for this build.",
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "by_hgvsc",
                    "by_hgvsp"
                  ],
                  "properties": {
                    "by_hgvsc": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "hgvsp": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "consequence": {
                            "type": "string"
                          },
                          "canonical": {
                            "type": "boolean"
                          },
                          "mane_select": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "by_hgvsp": {
                      "description": "Protein change -> the coding changes producing it.",
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "clinvar": {
          "description": "Present only when inject_clinvar_into_gofcards.py matched this variant.",
          "type": "object"
        },
        "clinvar_additional": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "clinvarVCV": {
      "type": "object",
      "required": [
        "mechanism_context",
        "match",
        "variation",
        "condition_assertions",
        "allelic_requirement"
      ],
      "properties": {
        "mechanism_context": {
          "type": "array",
          "items": {
            "const": "GOF"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "match": {
          "$ref": "#/$defs/exactMatch"
        },
        "variation": {
          "$ref": "#/$defs/variation"
        },
        "condition_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditionAssertion"
          }
        },
        "allelic_requirement": {
          "type": "object",
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "const": "unresolved"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "exactMatch": {
      "type": "object",
      "required": [
        "method",
        "gene_concordance",
        "matched_gofcards_records"
      ],
      "properties": {
        "method": {
          "const": "exact_normalized_vcf_allele"
        },
        "gene_concordance": {
          "type": "boolean"
        },
        "clinvar_gene_symbols": {
          "$ref": "#/$defs/stringArray"
        },
        "exact_cache_gene_symbols": {
          "$ref": "#/$defs/stringArray"
        },
        "discarded_gene_discordant_symbols": {
          "$ref": "#/$defs/stringArray"
        },
        "matched_gofcards_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "HGNC_Symbol",
              "gofcards_variant_id",
              "allele_key"
            ],
            "properties": {
              "HGNC_Symbol": {
                "type": "string",
                "minLength": 1
              },
              "GoFCards_HGNC_Symbol": {
                "type": "string",
                "minLength": 1
              },
              "VEP_HGNC_Symbol": {
                "type": "string",
                "minLength": 1
              },
              "gene_match_status": {
                "enum": [
                  "gene_concordant",
                  "source_gene_only"
                ]
              },
              "match_eligibility": {
                "const": "eligible"
              },
              "gofcards_accession_id": {
                "type": "string",
                "minLength": 1
              },
              "gofcards_variant_id": {
                "type": "string",
                "minLength": 1
              },
              "allele_key": {
                "type": "string",
                "minLength": 1
              },
              "hg19_vcf_key": {
                "type": "string",
                "minLength": 1
              },
              "hg38_vcf_key": {
                "type": "string",
                "minLength": 1
              },
              "disease": {
                "type": "string",
                "minLength": 1
              },
              "pmids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pscore": {
                "type": "string",
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "hg19_vcf_key"
                ]
              },
              {
                "required": [
                  "hg38_vcf_key"
                ]
              }
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "variation": {
      "type": "object",
      "required": [
        "variation_id",
        "vcv_accession",
        "record_type",
        "record_status",
        "classification_scope",
        "matched_component_context",
        "locations"
      ],
      "properties": {
        "variation_id": {
          "type": "string"
        },
        "vcv_accession": {
          "type": "string",
          "pattern": "^VCV"
        },
        "vcv_version": {
          "type": [
            "integer",
            "string"
          ]
        },
        "variation_name": {
          "type": "string"
        },
        "variation_type": {
          "type": "string"
        },
        "record_type": {
          "const": "classified"
        },
        "record_status": {
          "const": "current"
        },
        "date_created": {
          "type": "string"
        },
        "date_last_updated": {
          "type": "string"
        },
        "classification_scope": {
          "enum": [
            "simple_allele",
            "haplotype",
            "genotype"
          ]
        },
        "matched_component_context": {
          "enum": [
            "allele",
            "haplotype_component",
            "genotype_component",
            "genotype_haplotype_component"
          ]
        },
        "component_allele_id": {
          "type": "string"
        },
        "component_variation_id": {
          "type": "string"
        },
        "component_name": {
          "type": "string"
        },
        "component_variant_type": {
          "type": "string"
        },
        "canonical_spdi": {
          "type": "string"
        },
        "genes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "locations": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "GRCh37": {
              "$ref": "#/$defs/location"
            },
            "GRCh38": {
              "$ref": "#/$defs/location"
            }
          },
          "additionalProperties": false
        },
        "hgvs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "expression"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "expression": {
                "type": "string"
              },
              "sequence_accession_version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": [
        "chromosome",
        "position_vcf",
        "reference_allele_vcf",
        "alternate_allele_vcf",
        "vcf_key"
      ],
      "properties": {
        "assembly_accession_version": {
          "type": "string"
        },
        "chromosome": {
          "type": "string"
        },
        "position_vcf": {
          "type": [
            "integer",
            "string"
          ]
        },
        "reference_allele_vcf": {
          "type": "string"
        },
        "alternate_allele_vcf": {
          "type": "string"
        },
        "vcf_key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "conditionAssertion": {
      "type": "object",
      "required": [
        "rcv_accession",
        "conditions",
        "germline_classification",
        "matched_scvs",
        "scv_linkage"
      ],
      "properties": {
        "rcv_accession": {
          "type": "string",
          "pattern": "^RCV"
        },
        "rcv_version": {
          "type": [
            "integer",
            "string"
          ]
        },
        "title": {
          "type": "string"
        },
        "trait_set_id": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "database": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "germline_classification": {
          "type": "object",
          "required": [
            "review_status",
            "review_stars"
          ],
          "properties": {
            "clinical_significance": {
              "type": "string"
            },
            "review_status": {
              "enum": [
                "criteria provided, multiple submitters, no conflicts",
                "reviewed by expert panel",
                "practice guideline"
              ]
            },
            "review_stars": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            },
            "date_last_evaluated": {
              "type": "string"
            },
            "submission_count": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "additionalProperties": false
        },
        "matched_scvs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scv"
          }
        },
        "scv_linkage": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "scv": {
      "type": "object",
      "required": [
        "scv_accession",
        "record_status",
        "contributes_to_aggregate_classification",
        "classification",
        "trait_linkage_method"
      ],
      "properties": {
        "clinical_assertion_id": {
          "type": "string"
        },
        "scv_accession": {
          "type": "string",
          "pattern": "^SCV"
        },
        "scv_version": {
          "type": [
            "integer",
            "string"
          ]
        },
        "record_status": {
          "const": "current"
        },
        "contributes_to_aggregate_classification": {
